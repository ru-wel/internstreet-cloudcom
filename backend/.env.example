# Copy to .env and fill in. Never commit .env.

# Port the Express server listens on
PORT=3000

# Secret for signing login JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Neon Postgres: use the pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) connection, used by `npm run migrate`
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Neon object storage (the "uploads" bucket). `neon link`/`neon deploy` writes these as AWS_*.
# On Vercel, set them as S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY instead,
# because Vercel reserves the AWS_* names for its own credentials.
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.REGION.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
